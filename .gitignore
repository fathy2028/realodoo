# Python bytecode / caches
__pycache__/
*.py[cod]
*$py.class

# Packaging / build artifacts (pip, setuptools, wheel)
*.egg-info/
*.egg
build/
dist/
.eggs/

# Vendored web assets — these directory names collide with the generic
# build/ and dist/ rules above but ship as part of the Odoo source tree.
!odoo/addons/web/static/lib/bootstrap/dist/
!odoo/addons/web/static/lib/bootstrap/js/dist/
!odoo/addons/web/static/lib/pdfjs/build/
pip-wheel-metadata/
MANIFEST

# Virtual environments
.venv/
venv/
env/
ENV/

# Editor / OS
*~
*.swp
*.swo
.DS_Store
Thumbs.db
.idea/
.vscode/

# Odoo runtime
*.log
.odoorc
odoo.conf
/odoo/filestore/

# Node (in case any addon pulled them in)
node_modules/
.claude

# Debian packaging files must always be tracked
!odoo/debian/
!odoo/debian/**